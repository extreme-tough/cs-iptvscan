using System.Globalization;

public sealed partial class MainForm : Form
{
    public MainForm()
    {
        InitializeComponent();
        _fullUrlMode.CheckedChanged += (_, _) => UpdateInputMode();
        _loadButton.Click += async (_, _) => await LoadDetailsAsync();
        UpdateInputMode();
    }

    private static void AddInputRow(TableLayoutPanel panel, string label, Control input)
    {
        int row = panel.RowCount++;
        panel.RowStyles.Add(new RowStyle(SizeType.AutoSize));
        panel.Controls.Add(new Label { Text = label, AutoSize = true, Anchor = AnchorStyles.Left, Padding = new Padding(0, 6, 12, 0) }, 0, row);
        panel.Controls.Add(input, 1, row);
    }

    private void UpdateInputMode()
    {
        bool useFullUrl = _fullUrlMode.Checked;
        _fullUrlInput.Enabled = useFullUrl;
        _serverInput.Enabled = !useFullUrl;
        _usernameInput.Enabled = !useFullUrl;
        _passwordInput.Enabled = !useFullUrl;
    }

    private async Task LoadDetailsAsync()
    {
        _loadButton.Enabled = false;
        _status.Text = "Loading...";
        _details.Controls.Clear();
        _details.RowStyles.Clear();
        _details.RowCount = 0;

        try
        {
            XtreamIPTV client = _fullUrlMode.Checked
                ? new XtreamIPTV(_fullUrlInput.Text.Trim())
                : new XtreamIPTV(_serverInput.Text.Trim(), _usernameInput.Text, _passwordInput.Text);

            XtreamAccount account = await client.GetServerDetailsAsync();
            AddDetail("Status", account.Status);
            AddDetail("Subscription expires", account.ExpirationDate?.ToLocalTime().ToString("g", CultureInfo.CurrentCulture) ?? "No expiry / not provided");
            AddDetail("Trial account", account.IsTrial?.ToString() ?? "Not provided");
            AddDetail("Active connections", account.ActiveConnections?.ToString(CultureInfo.CurrentCulture) ?? "Not provided");
            AddDetail("Maximum connections", account.MaxConnections?.ToString(CultureInfo.CurrentCulture) ?? "Not provided");
            AddDetail("Server", account.Server?.Url);
            AddDetail("Port", account.Server?.Port);
            AddDetail("HTTPS port", account.Server?.HttpsPort);
            AddDetail("Protocol", account.Server?.Protocol);
            AddDetail("Timezone", account.Server?.Timezone);
            AddDetail("Server time", account.Server?.TimeNow);
            _status.Text = "Details loaded.";
        }
        catch (Exception ex)
        {
            _status.Text = $"Could not load details: {ex.Message}";
        }
        finally
        {
            _loadButton.Enabled = true;
        }
    }

    private void AddDetail(string name, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;

        int row = _details.RowCount++;
        _details.RowStyles.Add(new RowStyle(SizeType.AutoSize));
        _details.Controls.Add(new Label { Text = name, AutoSize = true, Padding = new Padding(0, 3, 12, 3) }, 0, row);
        _details.Controls.Add(new Label { Text = value, AutoSize = true, Padding = new Padding(0, 3, 0, 3) }, 1, row);
    }
}
