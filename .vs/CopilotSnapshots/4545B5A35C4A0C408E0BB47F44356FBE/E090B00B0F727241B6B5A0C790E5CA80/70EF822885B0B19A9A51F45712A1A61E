using System;
using System.Net.Http;
using System.Threading.Tasks;
using Newtonsoft.Json.Linq;


var xtreamIPTV = new XtreamIPTV("http://170.39.192.130:8080", "56941078981play", "110724play");
var (tvChannels, movies, tvShows) = await xtreamIPTV.GetXtreamStatsAsync();
Console.WriteLine($"TV Channels: {tvChannels}");
Console.WriteLine($"Movies: {movies}");
Console.WriteLine($"TV Shows: {tvShows}");

public class XtreamIPTV
{
    public XtreamIPTV()
    {
    }

    public XtreamIPTV(string serverUrl, string username, string password)
    {
        ServerUrl = serverUrl;
        Username = username;
        Password = password;
    }

    public string ServerUrl { get; set; } = string.Empty;
    public string Username { get; set; } = string.Empty;
    public string Password { get; set; } = string.Empty;

    public async Task<(int tvChannels, int movies, int tvShows)> GetXtreamStatsAsync()
    {
        string serverUrl = ServerUrl;
        string username = Username;
        string password = Password;

        try
        {
            using (HttpClient client = new HttpClient())
            {
                async Task<int> GetCountAsync(string category)
                {
                    string apiUrl = $"{serverUrl}/player_api.php?username={username}&password={password}&action=get_{category}";
                    HttpResponseMessage response = await client.GetAsync(apiUrl);
                    if (!response.IsSuccessStatusCode) return 0;
                    string jsonResponse = await response.Content.ReadAsStringAsync();
                    JArray data = JArray.Parse(jsonResponse);
                    return data.Count;
                }

                int tvChannels = await GetCountAsync("live_categories");
                int movies = await GetCountAsync("vod_categories");
                int tvShows = await GetCountAsync("series_categories");

                return (tvChannels, movies, tvShows);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            return (0, 0, 0);
        }
    }
}
